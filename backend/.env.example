# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Placeholder for future MongoDB Atlas integration)
MONGODB_URI=

# Authentication Configuration (Placeholder for future JWT integration)
JWT_SECRET=your_jwt_secret_key_here

# OAuth Configuration (Placeholders for future Social Auth)
