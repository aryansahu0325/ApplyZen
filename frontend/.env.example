# ──────────────────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# In production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables
# All variables MUST be prefixed with VITE_ to be exposed in the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# URL of your deployed backend API (Railway deployment URL)
# Production example: https://applyzen-backend.up.railway.app
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (public — safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_placeholder.apps.googleusercontent.com

# Microsoft OAuth Client ID (public — safe to expose in frontend)
VITE_MICROSOFT_CLIENT_ID=your_microsoft_oauth_client_id_placeholder
